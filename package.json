{
  "name": "random-criterion",
  "version": "1.0.0",
  "main": "build/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node build/src/index.js\"",
    "scrape": "npm run build && node --require tsconfig-paths/register build/src/index.js",
    "build": "npx prisma generate && tsc",
    "test": "jest --watch --detectOpenHandles",
    "deploy": "tsc && serverless deploy --stage dev aws-profile default"
  },
  "_moduleAliases": {
    "@src": "build/src",
    "@prisma_generated": "build/generated",
    "@prisma_client": "build/prisma/client",
    "@prisma": "build/prisma",
    "@types": "build/types"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "module-alias": "^2.2.3",
    "prisma": "^7.3.0",
    "serverless-plugin-typescript": "^2.1.5",
    "serverless-tscpaths": "^0.0.8",
    "ts-jest": "^29.3.2",
    "tsc-watch": "^6.2.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "p-all": "^5.0.1",
    "pg": "^8.17.2",
    "puppeteer": "^24.6.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "migrations": "prisma/migrations"
  }
}
